{
    "name": "mcp-central-agent",
    "version": "0.1.1",
    "description": "Local agent that tunnels private MCP servers to MCP Central",
    "author": "circle-rd",
    "license": "MIT",
    "homepage": "https://github.com/circle-rd/mcp-central-agent#readme",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/circle-rd/mcp-central-agent.git"
    },
    "bugs": {
        "url": "https://github.com/circle-rd/mcp-central-agent/issues"
    },
    "type": "module",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "bin": {
        "mcp-central-agent": "dist/cli.js"
    },
    "files": [
        "dist",
        "README.md",
        "LICENSE"
    ],
    "scripts": {
        "clean": "rm -rf dist",
        "build": "tsc",
        "dev": "tsc -w",
        "start": "node dist/cli.js start",
        "typecheck": "tsc --noEmit",
        "typecheck:tests": "tsc -p tsconfig.tests.json",
        "test": "vitest run",
        "lint": "eslint ."
    },
    "dependencies": {
        "@modelcontextprotocol/sdk": "^1.32.2",
        "commander": "^15.0.0",
        "socket.io-client": "^4.8.4",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@eslint/js": "^10.0.1",
        "@types/node": "^26.6.6",
        "eslint": "^10.14.0",
        "typescript": "~6.0.3",
        "typescript-eslint": "^8.72.1",
        "vitest": "^5.1.0"
    },
    "engines": {
        "node": ">=22.13.0"
    },
    "keywords": [
        "mcp",
        "model-context-protocol",
        "agent",
        "tunnel"
    ]
}
